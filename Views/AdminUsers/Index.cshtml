@model List<UserRowViewModel>
@{
    ViewData["Title"] = "Quản lý tài khoản";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Quản lý tài khoản</h1>
    <a class="btn btn-primary" asp-action="Create">Tạo tài khoản</a>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="table-responsive">
    <table class="table table-sm align-middle">
        <thead>
            <tr><th>Họ tên</th><th>Email</th><th>Vai trò</th><th>Trạng thái</th><th>Số lần sai</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.FullName</td>
                    <td>@u.Email</td>
                    <td>@u.Roles</td>
                    <td>
                        @if (u.IsLocked)
                        {
                            <span class="badge bg-danger">Đang khóa</span>
                        }
                        else
                        {

                            <span class="badge bg-success">Hoạt động</span>
                        }
                    </td>
                    <td>@u.AccessFailedCount</td>
                    <td>
                        @if (u.IsLocked)
                        {
                            <form asp-action="Unlock" asp-route-id="@u.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-success">Mở khóa</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Lock" asp-route-id="@u.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Khóa</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>