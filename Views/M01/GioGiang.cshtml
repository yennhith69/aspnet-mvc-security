@model GioGiangViewModel
@{ ViewData["Title"] = "Giờ giảng"; }
<h1 class="h3">Định mức giờ giảng - @Model.HoTen</h1>
<table class="table"><thead><tr><th>Năm học</th><th>Số giờ</th><th></th></tr></thead><tbody>@foreach (var x in Model.Items) {
    <tr>
        <td>@x.NamHoc</td><td>@x.SoGio</td>
        <td>
            @if (User.IsInRole(Roles.Hr) || User.IsInRole(Roles.Admin)) {
                <form asp-action="SuaGioGiang" method="post" class="d-inline-flex gap-1 align-items-center">
                    <input type="hidden" name="Id" value="@x.Id" />
                    <input type="hidden" name="NhanSuId" value="@Model.NhanSuId" />
                    <input name="NamHoc" value="@x.NamHoc" class="form-control form-control-sm" aria-label="Năm học" />
                    <input name="SoGio" value="@x.SoGio" class="form-control form-control-sm" type="number" min="0" max="10000" step="0.01" aria-label="Số giờ" />
                    <button class="btn btn-sm btn-outline-primary" type="submit">Lưu</button>
                </form>
                <form asp-action="XoaGioGiang" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@x.Id" />
                    <button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button>
                </form>
            }
        </td>
    </tr>
}
</tbody></table>
@if (User.IsInRole(Roles.Hr) || User.IsInRole(Roles.Admin)) { <form asp-action="GioGiang" method="post" class="row g-2 col-lg-6"><input asp-for="NhanSuId" type="hidden" /><div class="col-md-6"><input asp-for="NamHoc" class="form-control" placeholder="2025-2026" /></div><div class="col-md-4"><input asp-for="SoGio" class="form-control" /></div><div class="col-md-2"><button class="btn btn-primary">Thêm</button></div></form> }
