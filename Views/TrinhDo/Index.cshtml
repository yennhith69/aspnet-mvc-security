@model TrinhDoIndexViewModel
@{
    ViewData["Title"] = "Trình độ và minh chứng";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Trình độ và minh chứng</h1>
        <div class="text-muted">@Model.MaHrm - @Model.HoTen</div>
    </div>
    <div>
        @if (Model.CoQuyenSua)
        {
            <a class="btn btn-primary" asp-action="Create" asp-route-nhanSuId="@Model.NhanSuId">Thêm trình độ</a>
        }
        <a class="btn btn-link" asp-controller="NhanSu" asp-action="Details" asp-route-id="@Model.NhanSuId">Quay lại hồ sơ</a>
    </div>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}

<div class="table-responsive">
    <table class="table table-sm align-middle">
        <thead>
            <tr><th>Trình độ</th><th>Chuyên ngành</th><th>Đơn vị cấp</th><th>Minh chứng</th><th>Ghi chú</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var t in Model.Items)
            {
                <tr>
                    <td>@TrinhDoText.Loai(t.Loai)</td>
                    <td>@t.ChuyenNganh</td>
                    <td>@t.DonViCap</td>
                    <td>
                        @if (t.TepId.HasValue)
                        {
                            <a asp-action="Download" asp-route-id="@t.TepId">@t.TenGoc</a>
                        }
                        else
                        {

                            <span class="text-muted">Chưa có</span>
                        }
                    </td>
                    <td>@t.MoTa</td>
                    <td>
                        @if (Model.CoQuyenSua)
                        {
                            <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                            <form asp-action="Delete" method="post">
                                <input type="hidden" name="id" value="@t.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Items.Any())
            {
                <tr><td colspan="6" class="text-center text-muted">Chưa có trình độ nào.</td></tr>
            }
        </tbody>
    </table>
</div>