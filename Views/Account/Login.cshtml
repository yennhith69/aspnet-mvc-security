@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="login-page">
    <section class="login-showcase">
        <div class="login-brand">
            <span class="app-brand-mark" aria-hidden="true">N</span>
            <span>
                <strong>NEU-SecHRM</strong>
                <small>Hồ sơ cán bộ / giảng viên</small>
            </span>
        </div>
        <div class="login-showcase-copy">
            <p class="intro-label">CỔNG QUẢN LÝ NỘI BỘ</p>
            <h1>Quản trị hồ sơ nhân sự an toàn và minh bạch.</h1>
            <p>Tiếp nhận, cập nhật và tra cứu thông tin trong một không gian được bảo vệ theo vai trò và phạm vi hồ sơ.</p>
        </div>
        <div class="login-highlights">
            <span><b>01</b> Phân quyền theo vai trò</span>
            <span><b>02</b> Bảo vệ dữ liệu nhạy cảm</span>
            <span><b>03</b> Nhật ký thao tác đầy đủ</span>
        </div>
    </section>

    <section class="login-card" aria-labelledby="login-title">
        <div class="login-card-heading">
            <span class="welcome-mark" aria-hidden="true">→</span>
            <p class="intro-label">CHÀO MỪNG TRỞ LẠI</p>
            <h2 id="login-title">Đăng nhập hệ thống</h2>
            <p>Sử dụng tài khoản được cấp để tiếp tục.</p>
        </div>

        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="login-field">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" autocomplete="username" placeholder="you@hrm.test" autofocus />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="login-field">
                <label asp-for="Password" class="form-label">Mật khẩu</label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Nhập mật khẩu" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary login-submit">Đăng nhập <span aria-hidden="true">→</span></button>
        </form>
        <p class="login-security-note"><span aria-hidden="true">●</span> Phiên làm việc được bảo vệ bằng xác thực an toàn</p>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}