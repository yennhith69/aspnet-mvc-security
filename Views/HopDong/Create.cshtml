@model HopDongCreateViewModel
@{
    ViewData["Title"] = "Thêm hợp đồng";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="h3 mb-3">Thêm hợp đồng</h1>

        <form asp-action="Create" method="post">
            <input type="hidden" asp-for="NhanSuId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Loai" class="form-label">Loại hợp đồng</label>
                <select asp-for="Loai" class="form-select">
                    <option value="">-- Chọn --</option>
                    @foreach (var l in HopDongText.Loais)
                    {
                        <option value="@l">@HopDongText.Loai(l)</option>
                    }
                </select>
                <span asp-validation-for="Loai" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TuNgay" class="form-label">Từ ngày</label>
                <input asp-for="TuNgay" type="date" class="form-control" />
                <span asp-validation-for="TuNgay" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DenNgay" class="form-label">Đến ngày</label>
                <input asp-for="DenNgay" type="date" class="form-control" />
                <div class="form-text">Bỏ trống nếu là hợp đồng không xác định thời hạn.</div>
                <span asp-validation-for="DenNgay" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Lưu</button>
            <a class="btn btn-link" asp-action="Index" asp-route-nhanSuId="@Model.NhanSuId">Hủy</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}