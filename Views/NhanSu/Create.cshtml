@model NhanSuCreateViewModel
@{
    ViewData["Title"] = "Tiếp nhận hồ sơ";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <h1 class="h3 mb-3">Tiếp nhận hồ sơ</h1>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="HoTen" class="form-label">Họ tên</label>
                <input asp-for="HoTen" class="form-control" />
                <span asp-validation-for="HoTen" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="NgaySinh" class="form-label">Ngày sinh</label>
                    <input asp-for="NgaySinh" class="form-control" type="date" />
                    <span asp-validation-for="NgaySinh" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="GioiTinh" class="form-label">Giới tính</label>
                    <select asp-for="GioiTinh" class="form-select">
                        <option value="">-- Chọn --</option>
                        @foreach (var g in NhanSuText.GioiTinhs)
                        {
                            <option value="@g">@g</option>
                        }
                    </select>
                    <span asp-validation-for="GioiTinh" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="DienThoai" class="form-label">Điện thoại</label>
                    <input asp-for="DienThoai" class="form-control" />
                    <span asp-validation-for="DienThoai" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="DiaChiCuTru" class="form-label">Địa chỉ cư trú</label>
                <input asp-for="DiaChiCuTru" class="form-control" />
                <span asp-validation-for="DiaChiCuTru" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DonViId" class="form-label">Đơn vị</label>
                    <select asp-for="DonViId" class="form-select">
                        <option value="">-- Chọn --</option>
                        @foreach (var d in (List<DonVi>)ViewBag.DonVis)
                        {
                            <option value="@d.Id">@d.Ten</option>
                        }
                    </select>
                    <span asp-validation-for="DonViId" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ChucVuId" class="form-label">Chức vụ</label>
                    <select asp-for="ChucVuId" class="form-select">
                        <option value="">-- Không chọn --</option>
                        @foreach (var c in (List<ChucVu>)ViewBag.ChucVus)
                        {
                            <option value="@c.Id">@c.Ten</option>
                        }
                    </select>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="LoaiGiayTo" class="form-label">Loại giấy tờ</label>
                    <select asp-for="LoaiGiayTo" class="form-select">
                        @foreach (var l in NhanSuText.LoaiGiayTos)
                        {
                            <option value="@l">@l</option>
                        }
                    </select>
                    <span asp-validation-for="LoaiGiayTo" class="text-danger"></span>
                </div>
                <div class="col-md-8 mb-3">
                    <label asp-for="SoGiayTo" class="form-label">Số giấy tờ</label>
                    <input asp-for="SoGiayTo" class="form-control" autocomplete="off" />
                    <span asp-validation-for="SoGiayTo" class="text-danger"></span>
                </div>
            </div>

            <div class="form-check mb-3">
                <input asp-for="XacNhanKhongTrung" class="form-check-input" />
                <label asp-for="XacNhanKhongTrung" class="form-check-label">Tôi xác nhận đây không phải hồ sơ trùng (dùng khi hệ thống báo trùng họ tên và ngày sinh)</label>
            </div>

            <button type="submit" class="btn btn-primary">Tiếp nhận và cấp mã</button>
            <a class="btn btn-link" asp-action="Index">Quay lại</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}