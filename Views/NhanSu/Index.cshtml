@model NhanSuIndexViewModel
@{
    ViewData["Title"] = "Hồ sơ nhân sự";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Hồ sơ nhân sự</h2>
    @if (Model.CoQuyenSua)
    {
        <a asp-action="Create" class="btn btn-success">+ Tiếp nhận hồ sơ mới</a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Form tìm kiếm an toàn (Mục 9 & Mục 10: Tham số hóa truy vấn chống SQL Injection) -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Từ khóa (Mã hoặc Họ tên):</label>
                <input type="text" name="q" class="form-control" placeholder="Nhập tên hoặc mã..." value="@Model.Q" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Đơn vị / Khoa:</label>
                <select name="donViId" class="form-select">
                    <option value="">-- Tất cả đơn vị --</option>
                    @foreach (var dv in Model.DonVis)
                    {
                        if (Model.DonViId == dv.Id)
                        {
                            <option value="@dv.Id" selected="selected">@dv.Ten</option>
                        }
                        else
                        {
                            <option value="@dv.Id">@dv.Ten</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-5 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Xóa bộ lọc</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Mã HRM</th>
                        <th>Họ và tên</th>
                        <th>Đơn vị</th>
                        <th>Tình trạng</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                Không tìm thấy hồ sơ phù hợp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td><strong>@item.MaHrm</strong></td>
                                <td>@item.HoTen</td>
                                <td>@item.DonVi</td>
                                <td><span class="badge bg-info text-dark">@item.TinhTrangCongTac</span></td>
                                <td><span class="badge bg-secondary">@item.TrangThaiHoSo</span></td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Xem</a>
                                    @if (Model.CoQuyenSua)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Sửa</a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer d-flex justify-content-between align-items-center">
            <span>Tổng số: <strong>@Model.Total</strong> hồ sơ</span>
            <ul class="pagination mb-0">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-q="@Model.Q" asp-route-donViId="@Model.DonViId">@i</a>
                    </li>
                }
            </ul>
        </div>
    }
</div>