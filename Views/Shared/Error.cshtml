@model mvcSecurity.Models.ErrorViewModel
@{
    ViewData["Title"] = "Thông báo sự cố";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white py-3">
                    <h3 class="card-title mb-0">Hệ thống đã xảy ra sự cố</h3>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted fs-5 mb-4">
                        Yêu cầu của bạn tạm thời không thể xử lý. Thông tin lỗi chi tiết đã được bảo mật và lưu vào nhật ký hệ thống để quản trị viên khắc phục.
                    </p>

                    @if (Model.ShowRequestId)
                    {
                        <div class="alert alert-light border">
                            <span class="text-secondary">Mã định danh sự cố (Trace ID):</span><br />
                            <code class="text-danger fw-bold fs-6">@Model.RequestId</code>
                        </div>
                    }

                    <div class="mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 me-2">Về trang chủ</a>
                        <a href="javascript:history.back()" class="btn btn-outline-secondary px-4">Quay lại</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>