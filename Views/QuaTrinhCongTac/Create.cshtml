@model CongTacCreateViewModel
@{
    ViewData["Title"] = "Thêm giai đoạn công tác";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="h3 mb-3">Thêm giai đoạn công tác</h1>

        <form asp-action="Create" method="post">
            <input type="hidden" asp-for="NhanSuId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="DonViId" class="form-label">Đơn vị</label>
                <select asp-for="DonViId" class="form-select">
                    <option value="">-- Chọn --</option>
                    @foreach (var d in (List<DonVi>)ViewBag.DonVis)
                    {
                        <option value="@d.Id">@d.Ten</option>
                    }
                </select>
                <span asp-validation-for="DonViId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ChucVuId" class="form-label">Chức vụ</label>
                <select asp-for="ChucVuId" class="form-select">
                    <option value="">-- Không chọn --</option>
                    @foreach (var c in (List<ChucVu>)ViewBag.ChucVus)
                    {
                        <option value="@c.Id">@c.Ten</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="TuNgay" class="form-label">Từ ngày</label>
                <input asp-for="TuNgay" type="date" class="form-control" />
                <span asp-validation-for="TuNgay" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DenNgay" class="form-label">Đến ngày</label>
                <input asp-for="DenNgay" type="date" class="form-control" />
                <div class="form-text">Bỏ trống nếu đang công tác ở vị trí này.</div>
                <span asp-validation-for="DenNgay" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Lưu</button>
            <a class="btn btn-link" asp-action="Index" asp-route-nhanSuId="@Model.NhanSuId">Hủy</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}